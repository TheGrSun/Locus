{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/desmos_harness.py session"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 .cursor/hooks/desmos_harness.py before-mcp"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/desmos_harness.py after-tool",
        "matcher": "MCP"
      }
    ]
  }
}
